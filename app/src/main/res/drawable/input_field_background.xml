<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-4dp" android:top="-4dp" android:right="-4dp" android:bottom="-4dp">
        <shape android:shape="rectangle"><corners android:radius="@dimen/radius_card" /><stroke android:width="3dp" android:color="@color/neon_glow_outer" /></shape>
    </item>
    <item android:left="-2dp" android:top="-2dp" android:right="-2dp" android:bottom="-2dp">
        <shape android:shape="rectangle"><corners android:radius="@dimen/radius_card" /><stroke android:width="2dp" android:color="@color/neon_glow_mid" /></shape>
