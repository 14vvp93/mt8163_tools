<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background" android:orientation="vertical" android:padding="@dimen/page_padding">
<TextView style="@style/ModuleDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/voltage_description" />
<LinearLayout style="@style/ModuleCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:gravity="center_vertical">
<TextView style="@style/ModuleSectionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/voltage_current_correction" />
<TextView style="@style/VoltageOffsetValue" android:id="@+id/voltage_offset_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:text="@string/voltage_initial_offset" />
<SeekBar style="@style/VoltageSeekBar" android:id="@+id/voltage_offset" android:layout_width="match_parent" android:layout_height="@dimen/seekbar_height" android:layout_marginTop="@dimen/spacing_md" android:max="40" android:progress="20" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:orientation="horizontal">
<TextView style="@style/VoltageScaleLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/voltage_minimum" />
<TextView style="@style/VoltageScaleCenterLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/voltage_zero" />
<TextView style="@style/VoltageScaleLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/voltage_maximum" />
</LinearLayout>
<Button android:id="@+id/voltage_reset" android:layout_width="wrap_content" android:layout_height="@dimen/button_height" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/spacing_lg" android:minWidth="@dimen/button_min_width" android:text="@string/voltage_reset" />
</LinearLayout></LinearLayout>
