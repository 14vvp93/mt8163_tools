<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/dialog_window_background" android:orientation="vertical" android:padding="@dimen/card_padding">
<TextView style="@style/DialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/events_export_title" />
<Button android:id="@+id/events_export_filtered" style="@style/ModuleButton" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_lg" android:text="@string/events_export_filtered_label" />
<Button android:id="@+id/events_export_all" style="@style/ModuleButton" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_sm" android:text="@string/events_export_all_label" />
<Button android:id="@+id/events_export_cancel" style="@style/DialogSecondaryButton" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/spacing_md" android:text="@string/cancel" />
</LinearLayout>