<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOLTAGE"
            android:textColor="@color/neon_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Voltage Offset"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Adjust the voltage reported by the MCU"
            android:textColor="@color/text_muted"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="22dp"
            android:layout_weight="1"
            android:background="@color/panel_background"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="CURRENT CORRECTION"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/voltage_offset_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="+0.0 V"
                android:textColor="@color/text_primary"
                android:textSize="52sp"
                android:fontFamily="sans"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/voltage_offset"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="18dp"
                android:max="40"
                android:progress="20"
                android:progressTint="@color/neon_red"
                android:progressBackgroundTint="@color/line"
                android:thumbTint="@color/white"
                android:splitTrack="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="−2.0 V"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0.0 V"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="+2.0 V"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="STEP  0.1 V"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/voltage_reset"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/header_background"
                android:minHeight="64dp"
                android:text="Reset to 0.0 V"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
