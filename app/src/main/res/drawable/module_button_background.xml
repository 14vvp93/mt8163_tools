<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_disabled" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF41484D" />
            <stroke android:width="2dp" android:color="@color/neon_red" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF41484D" />
            <stroke android:width="2dp" android:color="@color/neon_red" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_background" />
            <stroke android:width="1dp" android:color="@color/button_stroke" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
