<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adjust the voltage reported by the MCU"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_section"
        android:background="@drawable/module_card_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/card_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CURRENT CORRECTION"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_label"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/voltage_offset_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="+0.0 V"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_large_value"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/voltage_offset"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:max="40"
            android:maxHeight="24dp"
            android:minHeight="24dp"
            android:progress="20"
            android:progressBackgroundTint="@color/line"
            android:progressTint="@color/neon_red"
            android:splitTrack="false"
            android:thumbTint="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="−2.0 V"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_label" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0.0 V"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="+2.0 V"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_label" />
        </LinearLayout>

        <Button
            android:id="@+id/voltage_reset"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg"
            android:minWidth="120dp"
            android:text="Reset" />
    </LinearLayout>
</LinearLayout>