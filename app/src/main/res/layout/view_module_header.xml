<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="@dimen/header_height"
    android:background="@color/header_background" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="@dimen/page_padding"
    android:paddingEnd="@dimen/page_padding">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/ModuleHeaderTitle" android:id="@+id/header_title" android:layout_width="wrap_content"
            android:layout_height="wrap_content"  />
        <TextView style="@style/ModuleHeaderStatus" android:id="@+id/header_status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs"
 />
    </LinearLayout>
    <Switch android:id="@+id/header_switch" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minWidth="@dimen/switch_min_width"
        android:minHeight="@dimen/button_height" android:showText="false" />
</LinearLayout>