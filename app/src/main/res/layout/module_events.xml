<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111316"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/events_refresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:text="Оновити"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/events_copy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:text="Копіювати"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/events_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:text="Очистити"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/events_export"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:minHeight="60dp"
            android:text="Експорт"
            android:textAllCaps="false"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/events_filter"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:minHeight="60dp"
        android:text="Усі модулі  ▾"
        android:textAllCaps="false"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/events_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="12dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp"
        android:textColor="#D3D3D3"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/events_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/events_entries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
