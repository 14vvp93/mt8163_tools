<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/protection_application_card"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    style="@style/ProtectionApplicationCard">

    <ImageView
        android:id="@+id/protection_app_icon"
        android:layout_width="@dimen/control_size_large"
        android:layout_height="@dimen/control_size_large"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/protection_app_name"
        style="@style/ProtectionApplicationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_sm" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/control_size_large"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/protection_indicator_cleaner"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            style="@style/ProtectionIndicator"
            android:contentDescription="@string/protection_indicator_cleaner"
            android:src="@drawable/ic_protection_cleaner" />

        <ImageView
            android:id="@+id/protection_indicator_hide"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            style="@style/ProtectionIndicator"
            android:contentDescription="@string/protection_indicator_hide"
            android:src="@drawable/ic_protection_hide" />

        <ImageView
            android:id="@+id/protection_indicator_close"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_xs"
            style="@style/ProtectionIndicator"
            android:contentDescription="@string/protection_indicator_close"
            android:src="@drawable/ic_protection_keep" />
    </LinearLayout>

    <View
        android:id="@+id/protection_separator"
        android:layout_width="@dimen/border_width"
        android:layout_height="@dimen/protection_separator_height"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:background="@color/line" />

    <ImageButton
        android:id="@+id/protection_app_settings"
        style="@style/ProtectionActionButton"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:contentDescription="@string/protection_application_settings"
        android:src="@drawable/ic_protection_settings" />

    <ImageButton
        android:id="@+id/protection_app_remove"
        style="@style/ProtectionActionButton"
        android:layout_width="@dimen/button_height"
        android:layout_height="@dimen/button_height"
        android:contentDescription="@string/protection_remove_application"
        android:src="@drawable/ic_protection_delete" />
</LinearLayout>
