<resources>
<style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/neon_red</item><item name="android:alertDialogTheme">@style/AppAlertDialogTheme</item><item name="android:buttonStyle">@style/ModuleButton</item><item name="android:editTextStyle">@style/ModuleEditText</item><item name="android:switchStyle">@style/AppSwitch</item><item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">@color/app_background</item><item name="android:navigationBarColor">@color/app_background</item><item name="android:windowBackground">@color/app_background</item></style>
<style name="ModuleButton" parent="@android:style/Widget.Material.Button"><item name="android:background">@drawable/module_button_background</item><item name="android:minHeight">@dimen/button_height</item><item name="android:minWidth">0dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">@dimen/text_button</item><item name="android:fontFamily">sans</item></style>
<style name="ModuleEditText" parent="@android:style/Widget.Material.EditText"><item name="android:textColor">@color/text_primary</item><item name="android:textColorHint">@color/text_muted</item><item name="android:textSize">@dimen/text_button</item><item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/neon_red</item></style>
<style name="AppAlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert"><item name="android:windowBackground">@drawable/dialog_window_background</item><item name="android:colorAccent">@color/neon_red</item><item name="android:textColorPrimary">@color/text_primary</item><item name="android:textColorSecondary">@color/text_secondary</item><item name="android:fontFamily">sans</item></style>
<style name="AppSwitch" parent="@android:style/Widget.Material.CompoundButton.Switch"><item name="android:thumbTint">@color/switch_thumb</item><item name="android:trackTint">@color/switch_track</item><item name="android:minWidth">@dimen/switch_min_width</item><item name="android:minHeight">@dimen/button_height</item><item name="android:switchMinWidth">@dimen/switch_track_min_width</item></style>
<style name="DialogTitle"><item name="android:textColor">@color/text_primary</item><item name="android:textSize">@dimen/text_section_title</item><item name="android:textStyle">bold</item></style>
<style name="DialogMessage"><item name="android:textColor">@color/text_secondary</item><item name="android:textSize">@dimen/text_body</item></style>
<style name="DialogPrimaryButton" parent="ModuleButton"><item name="android:minWidth">@dimen/button_min_width</item></style>
<style name="DialogSecondaryButton" parent="ModuleButton"><item name="android:minWidth">@dimen/button_min_width</item><item name="android:textColor">@color/text_secondary</item></style>
<style name="ProtectionApplicationName"><item name="android:textColor">@color/text_primary</item><item name="android:textSize">@dimen/text_section_title</item><item name="android:textStyle">bold</item><item name="android:singleLine">true</item><item name="android:ellipsize">end</item></style>
<style name="ProtectionIndicator"><item name="android:layout_width">@dimen/icon_size_small</item><item name="android:layout_height">@dimen/icon_size_small</item><item name="android:layout_marginStart">@dimen/spacing_xs</item><item name="android:layout_marginEnd">@dimen/spacing_xs</item><item name="android:scaleType">fitCenter</item><item name="android:tint">@color/protection_indicator_tint</item></style>
<style name="ProtectionActionButton"><item name="android:layout_width">@dimen/button_height</item><item name="android:layout_height">@dimen/button_height</item><item name="android:background">@drawable/module_button_background</item><item name="android:padding">@dimen/spacing_sm</item><item name="android:scaleType">center</item><item name="android:tint">@color/text_secondary</item></style>
<style name="ProtectionSettingCheckBox"><item name="android:layout_width">match_parent</item><item name="android:layout_height">@dimen/button_height</item><item name="android:buttonTint">@color/protection_checkbox_tint</item><item name="android:padding">@dimen/spacing_xs</item><item name="android:textColor">@color/text_primary</item><item name="android:textSize">@dimen/text_button</item></style>
<style name="ProtectionEmptyState"><item name="android:textColor">@color/text_muted</item><item name="android:textSize">@dimen/text_body</item></style>
<style name="ProtectionResultCount"><item name="android:textColor">@color/text_muted</item><item name="android:textSize">@dimen/text_secondary</item><item name="android:paddingTop">@dimen/spacing_xs</item><item name="android:paddingBottom">@dimen/spacing_xs</item></style>
<style name="ProtectionPickerName"><item name="android:textColor">@color/text_primary</item><item name="android:textSize">@dimen/text_button</item><item name="android:singleLine">true</item><item name="android:ellipsize">end</item></style>
<style name="ProtectionPickerPackage"><item name="android:textColor">@color/text_muted</item><item name="android:textSize">@dimen/text_secondary</item><item name="android:singleLine">true</item><item name="android:ellipsize">end</item></style>
<style name="ProtectionPickerAddIcon"><item name="android:tint">@color/text_secondary</item><item name="android:scaleType">fitCenter</item></style>
</resources>