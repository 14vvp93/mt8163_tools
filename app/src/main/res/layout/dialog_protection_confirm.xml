<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/protection_settings_dialog_width"
    android:layout_height="@dimen/protection_confirm_dialog_height"
    style="@style/DialogPanel">

    <TextView
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/protection_remove_title" />

    <TextView
        android:id="@+id/protection_confirm_message"
        style="@style/DialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/protection_confirm_cancel"
            style="@style/DialogSecondaryButton"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/protection_confirm_remove"
            style="@style/DialogPrimaryButton"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/remove" />
    </LinearLayout>
</LinearLayout>
