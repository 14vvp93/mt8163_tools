<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/protection_settings_dialog_width"
    android:layout_height="@dimen/protection_settings_dialog_height"
    style="@style/DialogPanel">

    <TextView
        android:id="@+id/protection_settings_title"
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Switch
        android:id="@+id/protection_setting_cleaner"
        style="@style/ProtectionSettingSwitch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/protection_setting_cleaner" />

    <Switch
        android:id="@+id/protection_setting_hide"
        style="@style/ProtectionSettingSwitch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/protection_setting_hide" />

    <Switch
        android:id="@+id/protection_setting_allow_close"
        style="@style/ProtectionSettingSwitch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/protection_setting_allow_close" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/protection_settings_cancel"
            style="@style/DialogSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/protection_settings_save"
            style="@style/DialogPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>