<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/neon_red</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="android:buttonStyle">@style/ModuleButton</item>
        <item name="android:editTextStyle">@style/ModuleEditText</item>
        <item name="android:switchStyle">@style/AppSwitch</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="ModuleButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/module_button_background</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="ModuleEditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/neon_red</item>
    </style>

    <style name="AppAlertDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_window_background</item>
        <item name="android:colorAccent">@color/neon_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="AppSwitch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
        <item name="android:minWidth">@dimen/switch_min_width</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:switchMinWidth">@dimen/switch_track_min_width</item>
    </style>

</resources>
